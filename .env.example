NEXT_PUBLIC_API_BASE_URL=http://localhost:5091

# ORB-B01 — Meta app id and WhatsApp Embedded Signup configuration id. Leave empty
# until the Meta app exists; "Conectar WhatsApp" shows a "no configurado" state
# instead of a broken button when these are unset.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=
